<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - NicApp</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>
    <div class="auth-container">
        <div class="auth-box">
            <h1 style="color: var(--primary); margin-bottom: 10px;">NicApp 🚌</h1>
            <p style="color: #666; margin-bottom: 20px;">Bienvenido de nuevo</p>

            <% if (locals.error) { %>
                <div
                    style="background: #ffebee; color: #c62828; padding: 10px; border-radius: 8px; margin-bottom: 15px;">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/login" method="POST">
                        <input class="auth-input" type="email" name="email"
                            placeholder="Correo Institucional / Personal" required>
                        <input class="auth-input" type="password" name="password" placeholder="Contraseña" required>
                        <button class="auth-btn" type="submit">Iniciar Sesión</button>
                    </form>

                    <p style="margin-top: 20px;">
                        ¿Eres nuevo? <a href="/registro" style="color: var(--primary); font-weight: bold;">Crea tu
                            cuenta</a>
                    </p>
                    <p style="margin-top: 10px;">
                        <a href="/" style="color: #999; text-decoration: none;">← Volver al mapa</a>
                    </p>
        </div>
    </div>
</body>

</html>
<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>NicApp - Rutas TUC</title>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>

  <div id="mapa"></div>

  <div class="creditos">
    © 2026 NicApp | Ingeniería de Sistemas (UNI)
  </div>

  <div class="nicapp-ui">

    <nav class="navbar">
      <div class="brand">
        <i class="fa-solid fa-bus-simple fa-lg"></i> NicApp
      </div>

      <div class="user-controls">
        <% if (usuario) { %>
          <div class="user-info-container">
            <div class="user-badge">
              <i class="fa-solid fa-circle-user"></i>
              <span>
                <%= usuario.nombre.split(' ')[0] %></span>
            </div>
            <a href="/logout" class="btn-logout" title="Cerrar Sesión">
              <i class="fa-solid fa-right-from-bracket"></i>
            </a>
          </div>
        <% } else { %>
          <a href="/login" class="btn-login-nav">
            <i class="fa-solid fa-user"></i> Entrar
          </a>
        <% } %>
      </div>
    </nav>

    <button class="gps-btn" onclick="ubicarUsuario()" title="Mi Ubicación">
      <i class="fa-solid fa-location-crosshairs"></i>
    </button>

    <div class="panel-rutas">
      <h3 style="margin-bottom: 15px; color: var(--primary); display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-route"></i> Rutas Disponibles
      </h3>

      <div class="search-container">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input type="text" id="buscador" class="search-input" placeholder="Buscar ruta (ej: 104)..." onkeyup="filtrarRutas()">
      </div>
      
      <div id="lista-rutas">
        <% if (rutasDisponibles && rutasDisponibles.length > 0) { %>
          <% rutasDisponibles.forEach((ruta) => { %>
            <div class="ruta-btn-container" data-codigo="<%= ruta.codigo_ruta %>">
              <button class="btn-ruta" onclick="mostrarRuta(' <%=ruta.codigo_ruta %>')">
                  <i class="fa-solid fa-bus" style="color: #666; margin-right: 8px;"></i>
                  Ruta <%= ruta.codigo_ruta %>
                    </button>

                    <% if (locals.usuario) { %>
                      <% const esFav=(typeof misFavoritos !=='undefined' && misFavoritos.includes(ruta.codigo_ruta)); %>
                        <span class="star-btn" onclick="toggleFavorito('<%= ruta.codigo_ruta %>', this)"
                          style="color: <%= esFav ? '#FFD700' : '#ccc' %>;">
                          <i class="<%= esFav ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
                        </span>
                        <% } %>
            </div>
            <% }); %>
              <% } else { %>
                <p style="text-align: center; color: #777;">Cargando rutas...</p>
                <% } %>
          </div>
          <div style="background: #e3f2fd; padding: 10px; border-radius: 8px; margin-bottom: 15px;">
            <h4 style="color: var(--primary); margin-bottom: 8px;"><i class="fa-solid fa-diamond-turn-right"></i> ¿A
              dónde vas?</h4>

            <div class="search-container" style="margin-bottom: 5px;">
              <input type="text" id="input-destino" class="search-input" placeholder="Ej: Metrocentro, UCA..."
                style="background: white;">
              <button onclick="buscarDestino()"
                style="position:absolute; right:5px; top:5px; padding:8px; border:none; background:var(--primary); color:white; border-radius:50%; cursor:pointer;">
                <i class="fa-solid fa-arrow-right"></i>
              </button>
            </div>
            <div id="instrucciones-viaje" style="font-size: 0.9rem; margin-top: 10px;"></div>
          </div>

          <button onclick="limpiarMapa()"
            style="width:100%; padding:10px; margin-top:10px; border:1px solid #ddd; background:white; border-radius:8px; cursor: pointer; color: #555;">
            <i class="fa-solid fa-eraser"></i> Limpiar Mapa
          </button>
      </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const map = L.map('mapa', { zoomControl: false }).setView([12.136, -86.25], 13);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
    L.control.zoom({ position: 'topright' }).addTo(map);

    let capaRutaActual = null;
    let marcadorUsuario = null;
    let circuloPrecision = null;
    let rastreoActivo = false;

    // --- FUNCIÓN DE BÚSQUEDA ---
    function filtrarRutas() {
      const texto = document.getElementById('buscador').value.toLowerCase();
      const filas = document.querySelectorAll('.ruta-btn-container');

      filas.forEach(fila => {
        const codigo = fila.getAttribute('data-codigo').toLowerCase();
        // Si el código contiene lo que escribes (ej: "11" encuentra "110", "114", etc.)
        if (codigo.includes(texto)) {
          fila.style.display = "flex";
        } else {
          fila.style.display = "none";
        }
      });
    }

    function ubicarUsuario() {
      if (!rastreoActivo) {
        if (window.location.protocol !== 'https:' && window.location.hostname !== 'localhost') {
          alert("⚠️ Requiere HTTPS para GPS.");
        }
        map.locate({ setView: true, maxZoom: 17, watch: true, enableHighAccuracy: true });
        rastreoActivo = true;

        // Cambio visual del botón GPS
        const btn = document.querySelector('.gps-btn');
        btn.style.background = '#e8f5e9';
        btn.style.color = '#28a745';
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs fa-beat"></i>'; // Icono animado
      } else {
        map.stopLocate();
        rastreoActivo = false;
        const btn = document.querySelector('.gps-btn');
        btn.style.background = 'white';
        btn.style.color = 'black';
        btn.innerHTML = '<i class="fa-solid fa-location-crosshairs"></i>';
        alert("Rastreo detenido");
      }
    }

    map.on('locationfound', (e) => {
      const radio = e.accuracy / 2;
      if (marcadorUsuario === null) {
        // Marcador personalizado con icono de persona
        const iconoUsuario = L.divIcon({
          className: 'custom-div-icon',
          html: "<div style='background-color:#4285F4; width: 12px; height: 12px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 5px rgba(0,0,0,0.5);'></div>",
          iconSize: [16, 16],
          iconAnchor: [8, 8]
        });

        marcadorUsuario = L.marker(e.latlng, { icon: iconoUsuario }).addTo(map).bindPopup("<b>Tú estás aquí</b>").openPopup();
        circuloPrecision = L.circle(e.latlng, { radius: radio, color: '#4285F4', fillOpacity: 0.15 }).addTo(map);
      } else {
        marcadorUsuario.setLatLng(e.latlng);
        circuloPrecision.setLatLng(e.latlng).setRadius(radio);
      }
    });

    map.on('locationerror', (e) => { if (rastreoActivo) alert("Error GPS: " + e.message); });

    async function mostrarRuta(nombre) {
      nombre = nombre.trim();
      if (capaRutaActual) map.removeLayer(capaRutaActual);

      try {
        const res = await fetch(`/api/ruta/${nombre}`);
        if (!res.ok) {
          const errorText = await res.text();
          throw new Error(`Servidor: ${res.status} - ${errorText}`);
        }
        const datos = await res.json();

        if (!datos.features || datos.features.length === 0) {
          alert("Ruta sin datos."); return;
        }

        capaRutaActual = L.geoJSON(datos, {
          style: (feature) => {
            if (feature.properties.tipo === 'ruta') {
              const color = feature.properties.sentido === 'ida' ? '#0047AB' : '#FF8C00';
              return { color: color, weight: 6, opacity: 0.8 };
            }
          },
          pointToLayer: (feature, latlng) => {
            if (feature.properties.tipo === 'parada') {
              return L.circleMarker(latlng, { radius: 5, fillColor: "white", color: "#333", weight: 1, opacity: 1, fillOpacity: 1 });
            }
          },
          onEachFeature: (feature, layer) => {
            // Iconos en el Popup
            const icono = feature.properties.tipo === 'parada' ? '<i class="fa-solid fa-sign-hanging"></i>' : '<i class="fa-solid fa-bus"></i>';
            const texto = feature.properties.tipo === 'parada' ? feature.properties.nombre : `Recorrido: ${feature.properties.sentido.toUpperCase()}`;
            layer.bindPopup(`<b>${icono} ${texto}</b>`);
          }
        }).addTo(map);

        if (window.innerWidth < 768) { document.querySelector('.panel-rutas').scrollTop = 0; }
        map.fitBounds(capaRutaActual.getBounds(), { padding: [50, 50] });

      } catch (e) { console.error(e); alert("❌ Error: " + e.message); }
    }

    function limpiarMapa() {
      if (capaRutaActual) { map.removeLayer(capaRutaActual); capaRutaActual = null; }
    }

    async function toggleFavorito(codigo, el) {
      try {
        const res = await fetch('/api/favorito', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ codigo_ruta: codigo })
        });
        const data = await res.json();
        // Cambiar icono e icono color
        const icono = el.querySelector('i');
        if (data.estado === 'agregado') {
          icono.classList.remove('fa-regular');
          icono.classList.add('fa-solid');
          el.style.color = '#FFD700';
        } else {
          icono.classList.remove('fa-solid');
          icono.classList.add('fa-regular');
          el.style.color = '#ccc';
        }
      } catch (e) { alert("Error guardando favorito"); }
    }
    let marcadorDestino = null;

    // 1. Convertir texto a coordenadas (Geocoding)
    async function buscarDestino() {
      const query = document.getElementById('input-destino').value;
      if (!query) return;

      // Usamos Nominatim (OpenStreetMap Gratis) limitado a Nicaragua
      const url = `https://nominatim.openstreetmap.org/search?format=json&q=${query}&countrycodes=ni&viewbox=-87,13,-83,10&bounded=1`;

      try {
        document.getElementById('instrucciones-viaje').innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Buscando lugar...';

        const res = await fetch(url);
        const data = await res.json();

        if (data.length > 0) {
          const lugar = data[0];
          const latDest = parseFloat(lugar.lat);
          const lonDest = parseFloat(lugar.lon);

          // Dibujar en mapa
          if (marcadorDestino) map.removeLayer(marcadorDestino);
          marcadorDestino = L.marker([latDest, lonDest], {
            icon: L.divIcon({ html: '<i class="fa-solid fa-flag-checkered" style="color:red; font-size:24px;"></i>', className: 'dummy' })
          }).addTo(map).bindPopup(lugar.display_name).openPopup();

          map.setView([latDest, lonDest], 14);

          // CALCULAR RUTA
          calcularRutaOptima(latDest, lonDest);
        } else {
          alert("Lugar no encontrado en Nicaragua.");
        }
      } catch (e) { alert("Error buscando lugar"); }
    }

    // 2. Preguntar al Backend cómo llegar
    // Variable global para limpiar las caminatas anteriores
    let capasCaminata = [];

    async function calcularRutaOptima(latDest, lonDest) {
      if (!marcadorUsuario) {
        alert("⚠️ Primero activa tu GPS (Botón 📍) para saber dónde estás.");
        return;
      }

      // Limpiamos caminatas anteriores si existen
      capasCaminata.forEach(layer => map.removeLayer(layer));
      capasCaminata = [];

      const latOrigen = marcadorUsuario.getLatLng().lat;
      const lonOrigen = marcadorUsuario.getLatLng().lng;
      const divInstrucciones = document.getElementById('instrucciones-viaje');

      divInstrucciones.innerHTML = '<i class="fa-solid fa-gears fa-spin"></i> Calculando...';

      try {
        const res = await fetch('/api/planificar-viaje', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lat_origen: latOrigen,
            lon_origen: lonOrigen,
            lat_destino: latDest,
            lon_destino: lonDest
          })
        });

        const data = await res.json();

        if (data.exito) {
          const opcion = data.opciones[0];

          // 1. Mostrar la Ruta del Bus
          mostrarRuta(opcion.codigo_ruta);

          // --- DIBUJAR CAMINATAS ---

          // A. Parsear coordenadas de las paradas (vienen como GeoJSON string)
          const geoOrigen = JSON.parse(opcion.geo_parada_origen);
          const geoDestino = JSON.parse(opcion.geo_parada_destino);

          // Nota: GeoJSON es [lon, lat], Leaflet usa [lat, lon]. Hay que invertir.
          const coordParadaSubida = [geoOrigen.coordinates[1], geoOrigen.coordinates[0]];
          const coordParadaBajada = [geoDestino.coordinates[1], geoDestino.coordinates[0]];

          // B. Línea Punteada 1: Tú -> Parada Subida
          const caminata1 = L.polyline([[latOrigen, lonOrigen], coordParadaSubida], {
            color: 'black',
            dashArray: '5, 10', // Esto hace el efecto punteado
            weight: 4,
            opacity: 0.6
          }).addTo(map);

          // C. Línea Punteada 2: Parada Bajada -> Destino
          const caminata2 = L.polyline([coordParadaBajada, [latDest, lonDest]], {
            color: 'black',
            dashArray: '5, 10',
            weight: 4,
            opacity: 0.6
          }).addTo(map);

          // D. Resaltar Parada de Subida (Círculo Verde Pulsante)
          const marcaSubida = L.circleMarker(coordParadaSubida, {
            radius: 8,
            fillColor: "#00e676", // Verde brillante
            color: "black",
            weight: 2,
            fillOpacity: 1
          }).bindPopup("<b>👋 ¡Sube aquí!</b>").addTo(map).openPopup();

          // E. Resaltar Parada de Bajada (Círculo Rojo)
          const marcaBajada = L.circleMarker(coordParadaBajada, {
            radius: 8,
            fillColor: "#ff1744", // Rojo alerta
            color: "black",
            weight: 2,
            fillOpacity: 1
          }).bindPopup("<b>🛑 ¡Bájate aquí!</b>").addTo(map);

          // Guardamos todo para poder borrarlo después
          capasCaminata.push(caminata1, caminata2, marcaSubida, marcaBajada);

          // --- MOSTRAR TEXTO ---
          divInstrucciones.innerHTML = `
                    <div style="background: white; padding: 10px; border-radius: 5px; border-left: 5px solid ${opcion.color_hex}; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                        <h4 style="margin:0; color: ${opcion.color_hex};">¡Toma la Ruta ${opcion.codigo_ruta}! <i class="fa-solid fa-bus"></i></h4>
                        <ul style="padding-left: 20px; margin: 5px 0; font-size: 0.9rem; color: #555;">
                            <li>🏃‍♂️ Camina <b>${Math.round(opcion.distancia_caminar_origen)}m</b> (Línea punteada) hasta <b>${opcion.parada_origen}</b>.</li>
                            <li>🚌 Viaja en la ruta.</li>
                            <li>🛑 Bájate en <b>${opcion.parada_destino}</b>.</li>
                            <li>🏁 Camina <b>${Math.round(opcion.distancia_caminar_destino)}m</b> a tu destino.</li>
                        </ul>
                    </div>
                `;
        } else if (data.error) {
          divInstrucciones.innerHTML = `<div style="color:red;">❌ Error: ${data.error}</div>`;
        } else {
          divInstrucciones.innerHTML = `<div style="color:orange;">${data.mensaje || 'Sin ruta directa.'}</div>`;
        }
      } catch (e) {
        console.error(e);
        divInstrucciones.innerHTML = `<div style="color:red;">Error de conexión.</div>`;
      }
    }
  </script>
</body>

</html>
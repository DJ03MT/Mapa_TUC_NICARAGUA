<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>NicApp - Rutas TUC</title>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>

  <div id="mapa"></div>

  <div class="creditos">
    © 2026 NicApp | Desarrollado por Estudiante de Ingeniería de Sistemas (UNI)
  </div>

  <div class="nicapp-ui">

    <nav class="navbar">
      <div class="brand">
        🚌 NicApp
      </div>
      <div class="user-controls">
        <% if (usuario) { %>
          <a href="/logout">Salir (<%= usuario.nombre.split(' ')[0] %>)</a>
                <% } else { %>
                    <a href="/login" style="background: var(--primary); color: white;">Entrar</a>
                <% } %>
            </div>
        </nav>

        <button class="gps-btn" onclick="ubicarUsuario()" title="Mi Ubicación">
            📍
        </button>

        <div class="panel-rutas">
            <h3 style="margin-bottom: 15px; color: var(--primary);">Rutas Disponibles</h3>
            
            <% if (rutasDisponibles && rutasDisponibles.length > 0) { %>
                <% rutasDisponibles.forEach((ruta) => { %>
                    <div class="ruta-btn-container">
                        <button class="btn-ruta" onclick="mostrarRuta(' <%=ruta.codigo_ruta %>')">
              Ruta <%= ruta.codigo_ruta %>
                </button>

                <% if (locals.usuario) { %>
                  <% const esFav=(typeof misFavoritos !=='undefined' && misFavoritos.includes(ruta.codigo_ruta)); %>
                    <span class="star-btn" onclick="toggleFavorito('<%= ruta.codigo_ruta %>', this)">
                      <%= esFav ? '⭐' : '☆' %>
                    </span>
                    <% } %>
      </div>
      <% }); %>
        <% } else { %>
          <p style="text-align: center; color: #777;">Cargando rutas...</p>
          <% } %>

            <button onclick="limpiarMapa()"
              style="width:100%; padding:10px; margin-top:10px; border:1px solid #ddd; background:white; border-radius:8px;">
              Limpiar Mapa
            </button>
  </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    // 1. INICIALIZAR MAPA
    const map = L.map('mapa', { zoomControl: false }).setView([12.136, -86.25], 13);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

    // Mover controles de zoom a la derecha arriba
    L.control.zoom({ position: 'topright' }).addTo(map);

    let capaRutaActual = null;
    let marcadorUsuario = null;
    let circuloPrecision = null;
    let rastreoActivo = false;

    // --- GPS MEJORADO ---
    function ubicarUsuario() {
      if (!rastreoActivo) {
        // Chequeo de seguridad para iPhone/Android
        if (window.location.protocol !== 'https:' && window.location.hostname !== 'localhost') {
          alert("⚠️ ALERTA DE SEGURIDAD ⚠️\n\nTu celular bloquea el GPS porque esta conexión no es HTTPS.\n\nPara que funcione en el iPhone, necesitas un certificado SSL o usar 'ngrok' en desarrollo.");
        }

        map.locate({ setView: true, maxZoom: 17, watch: true, enableHighAccuracy: true });
        rastreoActivo = true;
        // Feedback visual botón
        document.querySelector('.gps-btn').style.background = '#e8f5e9';
        document.querySelector('.gps-btn').style.border = '2px solid #28a745';
      } else {
        map.stopLocate();
        rastreoActivo = false;
        document.querySelector('.gps-btn').style.background = 'white';
        document.querySelector('.gps-btn').style.border = 'none';
        alert("Rastreo detenido");
      }
    }

    map.on('locationfound', (e) => {
      const radio = e.accuracy / 2;
      if (marcadorUsuario === null) {
        marcadorUsuario = L.marker(e.latlng).addTo(map).bindPopup("Tú").openPopup();
        circuloPrecision = L.circle(e.latlng, { radius: radio, color: '#0047AB' }).addTo(map);
      } else {
        marcadorUsuario.setLatLng(e.latlng);
        circuloPrecision.setLatLng(e.latlng).setRadius(radio);
      }
    });

    map.on('locationerror', (e) => {
      alert("Error GPS: " + e.message + "\n(Recuerda: En iPhone requieres HTTPS)");
    });

    // --- FUNCIONES DE RUTA Y FAVORITOS (Las mismas de antes) ---
    async function mostrarRuta(nombre) {
      if (capaRutaActual) map.removeLayer(capaRutaActual);

      try {
        const res = await fetch(`/api/ruta/${nombre}`);
        if (!res.ok) throw new Error("Error API");
        const datos = await res.json();

        capaRutaActual = L.geoJSON(datos, {
          style: (feature) => {
            if (feature.properties.tipo === 'ruta') {
              // Ida (Azul UNI), Vuelta (Amarillo/Naranja)
              const color = feature.properties.sentido === 'ida' ? '#0047AB' : '#FF8C00';
              return { color: color, weight: 6, opacity: 0.8 };
            }
          },
          pointToLayer: (feature, latlng) => {
            if (feature.properties.tipo === 'parada') {
              return L.circleMarker(latlng, { radius: 5, fillColor: "white", color: "#000", weight: 1, opacity: 1, fillOpacity: 1 });
            }
          },
          onEachFeature: (feature, layer) => {
            layer.bindPopup(feature.properties.tipo === 'parada' ?
              `🚏 ${feature.properties.nombre}` :
              `🚌 Recorrido: ${feature.properties.sentido.toUpperCase()}`);
          }
        }).addTo(map);

        // Mover panel en móvil para ver el mapa
        if (window.innerWidth < 768) {
          document.querySelector('.panel-rutas').scrollTop = 0; // Reset scroll
          // Opcional: Colapsar panel
        }

        map.fitBounds(capaRutaActual.getBounds(), { padding: [50, 50] });

      } catch (e) { alert("Error cargando ruta"); }
    }

    function limpiarMapa() {
      if (capaRutaActual) { map.removeLayer(capaRutaActual); capaRutaActual = null; }
    }

    async function toggleFavorito(codigo, el) {
      try {
        const res = await fetch('/api/favorito', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ codigo_ruta: codigo })
        });
        const data = await res.json();
        el.innerHTML = data.estado === 'agregado' ? '⭐' : '☆';
      } catch (e) { alert("Error guardando favorito"); }
    }
  </script>
</body>

</html>